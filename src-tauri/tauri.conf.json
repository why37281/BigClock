{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BigClock",
  "version": "0.1.0",
  "identifier": "com.bigclock.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BigClock",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#0D1315",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "why37281",
    "category": "Utility",
    "shortDescription": "教室晚自习大屏时钟",
    "longDescription": "4K 大屏时间展示，分段胶囊进度条由作息表驱动；支持整屏/左半屏/右半屏，配置文件与 exe 同目录且支持热重载。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
